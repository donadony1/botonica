# ================================================================
# NDOLO RITUALS — Variables d'Environnement Backend PHP
# RÈGLE ABSOLUE : Ce fichier ne doit JAMAIS être commité dans Git.
# Copiez-le en .env et remplissez avec vos vraies valeurs.
# ================================================================

# --- APPLICATION ---
APP_ENV=development
APP_URL=http://localhost:8000

# --- BASE DE DONNÉES ---
# Moteur : mysql (XAMPP/MySQL 8) ou pgsql (Supabase/PostgreSQL)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ndolo_rituals
DB_USER=root
DB_PASS=

# Pour Supabase PostgreSQL, utilisez les valeurs du Dashboard
# DB_DRIVER=pgsql
# DB_HOST=aws-0-eu-west-3.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.xxxxxxxxxxxx
# DB_PASS=VotreMotDePasseSupabase

# --- CORS ---
# URL de votre frontend React (Vite dev sur 5173, production sur votre domaine)
FRONTEND_URL=http://localhost:5173

# --- PAIEMENTS (à remplir en Phase 4) ---
STRIPE_SECRET_KEY=sk_test_VOTRE_CLE_TEST_STRIPE
STRIPE_WEBHOOK_SECRET=whsec_VOTRE_SECRET_WEBHOOK_STRIPE
PAYPAL_CLIENT_ID=VOTRE_CLIENT_ID_PAYPAL_SANDBOX
PAYPAL_CLIENT_SECRET=VOTRE_CLIENT_SECRET_PAYPAL_SANDBOX
ORANGE_MONEY_API_KEY=VOTRE_CLE_API_ORANGE_MONEY
MTN_MOMO_API_KEY=VOTRE_CLE_API_MTN_MOMO

# --- EMAILS (à remplir en Phase 4) ---
SMTP_HOST=smtp.votre-hebergeur.fr
SMTP_PORT=465
SMTP_USER=contact@ndolo-rituals.fr
SMTP_PASS=VotreMotDePasseEmail
MAIL_FROM=contact@ndolo-rituals.fr
MAIL_FROM_NAME=Ndolo Rituals

# --- SÉCURITÉ ---
# Générez une clé aléatoire de 64 caractères (openssl rand -hex 32)
JWT_SECRET=CHANGEZ_CETTE_CLE_AVEC_UNE_VALEUR_ALEATOIRE_DE_64_CARACTERES

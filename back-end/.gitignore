# Environnement & Secrets (JAMAIS dans Git)
.env*
!.env.example

# Logs applicatifs
logs/
*.log

# Dépendances PHP (si Composer est utilisé)
vendor/

# Dossiers temporaires
tmp/
cache/

# Factures et emails générés localement
storage/emails/*
!storage/emails/.gitkeep
public/invoices/*
!public/invoices/.gitkeep
public/uploads/products/*
!public/uploads/products/.gitkeep
!public/uploads/.htaccess
